<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Public.master.cs" Inherits="AIE.Public" %>
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head runat="server">
    <meta charset="utf-8" />
    <title>Saudi First AI Summit in Radiology and Health Innovation (SAIRH)</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta content="Saudi First AI Summit in Radiology and Health Innovation" name="description" />
    <meta content="SAIRH, AI, Radiology, Health Innovation, Saudi Arabia, 2026" name="keywords" />
    <meta content="SAIRH" name="author" />

    <!-- Core Stylesheets -->
    <link id="bootstrap" href="<%= ResolveUrl("~/Content/css/bootstrap.min.css") %>" rel="stylesheet" type="text/css" />
    <link id="bootstrapgrid" href="<%= ResolveUrl("~/Content/css/bootstrap-grid.min.css") %>" rel="stylesheet" type="text/css" />
    <link id="bootstrapreboot" href="<%= ResolveUrl("~/Content/css/bootstrap-reboot.min.css") %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveUrl("~/Content/css/animate.css") %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveUrl("~/Content/css/owl.carousel.css") %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveUrl("~/Content/css/owl.theme.css") %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveUrl("~/Content/css/owl.transitions.css") %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveUrl("~/Content/css/magnific-popup.css") %>" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
    <link href="<%= ResolveUrl("~/Content/css/style.css") %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveUrl("~/Content/css/live-dashboard.css") %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveUrl("~/Content/css/liquid-glass-theme.css?v=20261005_scroll_all_v7") %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveUrl("~/Content/css/auth.css") %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveUrl("~/Content/css/chat.css?v=20261005_pos") %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveUrl("~/Content/images/logo.jpg") %>" rel="icon" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>

<body>
    <form id="form1" runat="server">
        <div id="wrapper">
            <!-- Merged Sticky Liquid Glass Header (Unified Navbar with Icons & Actions) -->
            <header class="header-dark">
                <div class="container-fluid header-container">
                    <div class="header-inner">
                        <!-- Logo -->
                        <div id="logo">
                            <a href="~/" runat="server">
                                <img alt="SAIRH Logo" class="logo" src="<%= ResolveUrl("~/Content/images/background/SAIRH_logo_transparent.svg") %>" />
                            </a>
                        </div>

                        <!-- Navigation & Actions Container -->
                        <div class="header-nav-container" id="headerNavContainer">
                            <!-- Main Navigation Menu -->
                            <ul id="mainmenu">
                                <li><a href="~/" runat="server" id="linkHome"><i class="bi bi-house-door"></i> <span>Home</span></a></li>
                                <li><a href="Ceremony" runat="server" id="linkCeremony"><i class="bi bi-calendar2-check"></i> <span>Program &amp; Tracks</span></a></li>
                                <li><a href="Schedules" runat="server" id="linkSchedules"><i class="bi bi-buildings"></i> <span>Exhibition</span></a></li>
                                <li><a href="Speakers" runat="server" id="linkSpeakers"><i class="bi bi-people"></i> <span>Speakers</span></a></li>
                                <li><a href="Sponsors" runat="server" id="linkSponsors"><i class="bi bi-award"></i> <span>Sponsors</span></a></li>
                                <li><a href="ContactUs" runat="server" id="linkContactUs"><i class="bi bi-envelope"></i> <span>Contact</span></a></li>
                            </ul>

                            <!-- Account & Language Switcher Group -->
                            <div class="header-actions">
                                <!-- Signed In User Account Dropdown -->
                                <div class="header-user-dropdown" runat="server" id="liProfile" ClientIDMode="Static">
                                    <button type="button" class="action-pill user-dropdown-toggle" id="userDropdownTrigger" aria-label="User Account Menu" aria-haspopup="true">
                                        <i class="bi bi-person-circle"></i>
                                        <span>Account</span>
                                        <i class="bi bi-chevron-down user-dropdown-caret"></i>
                                    </button>
                                    <div class="user-dropdown-menu" id="userDropdownMenu">
                                        <div class="user-dropdown-header">
                                            <div class="user-dropdown-avatar">
                                                <i class="bi bi-person-circle"></i>
                                            </div>
                                            <div class="user-dropdown-info">
                                                <span class="user-dropdown-badge"><i class="bi bi-check-circle"></i> Signed In</span>
                                                <span class="user-dropdown-greeting">Attendee Account</span>
                                            </div>
                                        </div>
                                        <div class="user-dropdown-divider"></div>
                                        <asp:LinkButton ID="BtnProfile" runat="server" PostBackUrl="~/Profile.aspx" CssClass="user-dropdown-item">
                                            <i class="bi bi-person-badge"></i> <span>My Profile &amp; Pass</span>
                                        </asp:LinkButton>
                                        <span runat="server" id="liDashboard" style="display:none;">
                                            <asp:LinkButton ID="BtnDashboard" runat="server" PostBackUrl="~/Admin/ManageSummit.aspx" CssClass="user-dropdown-item">
                                                <i class="bi bi-shield-lock"></i> <span>Manage Summit (Admin)</span>
                                            </asp:LinkButton>
                                        </span>
                                        <div class="user-dropdown-divider"></div>
                                        <span runat="server" id="liLogOut">
                                            <asp:LinkButton ID="BtnSignOut" runat="server" OnClick="BtnSignOut_Click" CssClass="user-dropdown-item user-dropdown-item-danger">
                                                <i class="bi bi-box-arrow-right"></i> <span>Sign out</span>
                                            </asp:LinkButton>
                                        </span>
                                    </div>
                                </div>

                                <!-- Guest State: Sign in & Register Buttons (Shown only when not signed in) -->
                                <div class="header-guest-actions" runat="server" id="liLogin" ClientIDMode="Static">
                                    <a href="Login" class="action-pill"><i class="bi bi-box-arrow-in-right"></i> <span>Sign in</span></a>
                                    <a href="Register" class="action-pill action-pill-primary"><i class="bi bi-person-plus"></i> <span>Register</span></a>
                                </div>

                                <!-- Language Switcher -->
                                <div class="menu-action-lang">
                                    <asp:LinkButton ID="BtnToAr" runat="server" CssClass="action-pill lang-switcher-pill" OnClick="BtnToAr_Click"><i class="bi bi-globe"></i> <span>العربية</span></asp:LinkButton>
                                </div>
                            </div>
                        </div>

                        <!-- 2nd Logo: Year of AI 2026 Partner Logo & Mobile Hamburger Toggle -->
                        <div class="header-end-controls">
                            <span id="menu-btn" role="button" aria-label="Toggle navigation"></span>
                            <div class="header-partner-logo">
                                <a href="https://sdaia.gov.sa" target="_blank" rel="noopener noreferrer" title="The Year of Artificial Intelligence 2026">
                                    <img alt="The Year of Artificial Intelligence 2026" class="year-of-ai-logo" src="<%= ResolveUrl("~/Content/images/year-of-ai-2026-logo-white.png") %>" />
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Instant Mutual Exclusivity Guard & Mobile Navigation Toggle Script -->
                <script>
                    (function () {
                        // Instant mutual exclusivity between profile and login
                        var profile = document.getElementById('liProfile');
                        var login = document.getElementById('liLogin');
                        if (profile && login) {
                            login.style.setProperty('display', 'none', 'important');
                        }

                        // Robust mobile menu toggle & outside click handler
                        function setupMenuToggle() {
                            var menuBtn = document.getElementById('menu-btn');
                            var header = document.querySelector('header');
                            if (!menuBtn || !header) return;

                            menuBtn.onclick = function (e) {
                                e.preventDefault();
                                e.stopPropagation();
                                header.classList.toggle('menu-open');
                            };

                            // Close menu when clicking outside
                            document.addEventListener('click', function (e) {
                                if (header.classList.contains('menu-open') && !header.contains(e.target)) {
                                    header.classList.remove('menu-open');
                                }
                            });

                            // Close menu when clicking an active menu link
                            var navLinks = header.querySelectorAll('ul#mainmenu a:not(.user-dropdown-toggle)');
                            for (var i = 0; i < navLinks.length; i++) {
                                navLinks[i].addEventListener('click', function () {
                                    header.classList.remove('menu-open');
                                });
                            }
                        }

                        if (document.readyState === 'loading') {
                            document.addEventListener('DOMContentLoaded', setupMenuToggle);
                        } else {
                            setupMenuToggle();
                        }
                    })();
                </script>
            </header>

            <!-- Main Content Area -->
            <div class="no-bottom no-top" id="content">
                <div id="top"></div>
                <asp:ScriptManager ID="ScriptManager1" runat="server"></asp:ScriptManager>
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
            </div>

            <a href="#" id="back-to-top" aria-label="Back to Top"></a>

            <!-- Modern Liquid Glass Footer -->
            <footer class="sairh-footer">
                <div class="container">
                    <div class="sairh-footer-inner">
                        <div class="sairh-footer-social">
                            <a href="mailto:iie@iau.edu.sa" title="Email" class="sairh-footer-link">
                                <i class="bi bi-envelope"></i>
                                <span>iie@iau.edu.sa</span>
                            </a>
                            <a href="https://twitter.com/IAU_VPSRI" target="_blank" rel="noopener noreferrer" title="X (Twitter)" class="sairh-footer-link">
                                <i class="bi bi-twitter-x"></i>
                                <span>@IAU_VPSRI</span>
                            </a>
                            <a href="https://apps.apple.com/us/app/annual-innovation-event/id6475714056" target="_blank" rel="noopener noreferrer" title="Apple App Store" class="sairh-footer-link">
                                <i class="bi bi-apple"></i>
                                <span>App Store</span>
                            </a>
                            <a href="https://play.google.com/store/apps/details?id=sa.edu.iau.annualinnovationevent" target="_blank" rel="noopener noreferrer" title="Google Play" class="sairh-footer-link">
                                <i class="bi bi-google-play"></i>
                                <span>Google Play</span>
                            </a>
                        </div>
                        <div class="sairh-footer-copy">
                            &copy; <%=DateTime.Now.Year.ToString() %> SAIRH &bull; Saudi First AI Summit in Radiology &amp; Health Innovation
                        </div>
                    </div>
                </div>
            </footer>

            <!-- Preloader -->
            <div id="preloader">
                <div class="spinner">
                    <div class="bounce1"></div>
                    <div class="bounce2"></div>
                    <div class="bounce3"></div>
                </div>
            </div>
        </div>

        <!-- Core JavaScript Files -->
        <script src="<%= ResolveUrl("~/Content/js/jquery.min.js") %>"></script>
        <script src="<%= ResolveUrl("~/Content/js/popper.min.js") %>"></script>
        <script src="<%= ResolveUrl("~/Content/js/bootstrap.min.js") %>"></script>
        <script src="<%= ResolveUrl("~/Content/js/wow.min.js") %>"></script>
        <script src="<%= ResolveUrl("~/Content/js/jquery.isotope.min.js") %>"></script>
        <script src="<%= ResolveUrl("~/Content/js/easing.js") %>"></script>
        <script src="<%= ResolveUrl("~/Content/js/owl.carousel.js") %>"></script>
        <script src="<%= ResolveUrl("~/Content/js/validation.js") %>"></script>
        <script src="<%= ResolveUrl("~/Content/js/jquery.magnific-popup.min.js") %>"></script>
        <script src="<%= ResolveUrl("~/Content/js/enquire.min.js") %>"></script>
        <script src="<%= ResolveUrl("~/Content/js/jquery.stellar.min.js") %>"></script>
        <script src="<%= ResolveUrl("~/Content/js/jquery.plugin.js") %>"></script>
        <script src="<%= ResolveUrl("~/Content/js/typed.js") %>"></script>
        <script src="<%= ResolveUrl("~/Content/js/jquery.countTo.js") %>"></script>
        <script src="<%= ResolveUrl("~/Content/js/jquery.countdown.js") %>"></script>
        <script src="<%= ResolveUrl("~/Content/js/designesia.js") %>"></script>

        <script>
            $(function () {
                if ($('.typed-strings').length && $(".typed").length) {
                    $(".typed").typed({
                        stringsElement: $('.typed-strings'),
                        typeSpeed: 100,
                        backDelay: 1500,
                        loop: true,
                        contentType: 'html',
                        loopCount: false
                    });
                }
            });
        </script>

        <!-- Live Dashboard & Scroll Reveal Scripts -->
        <script src="<%= ResolveUrl("~/Scripts/dashboard.js") %>"></script>
        <script src="<%= ResolveUrl("~/Scripts/scroll-reveal.js?v=20261005_scroll_all_v7") %>"></script>
        <script src="<%= ResolveUrl("~/Scripts/hero-slider.js") %>"></script>
        <script src="<%= ResolveUrl("~/Content/js/auth.js") %>"></script>

        <!-- SAIRH AI Chatbot Interactive Floating Action Button & Window -->
        <div id="sairh-chat-fab-container" class="sairh-chat-fab-wrap">
            <button type="button" id="chat-toggle-btn" class="sairh-chat-fab" aria-label="Open SAIRH AI Chatbot" onclick="toggleChatWindow()">
                <span class="sairh-chat-fab-icon-wrap">
                    <i class="bi bi-chat-dots-fill sairh-icon-chat"></i>
                    <i class="bi bi-x-lg sairh-icon-close"></i>
                </span>
                <span class="sairh-chat-fab-badge"><i class="bi bi-stars"></i></span>
            </button>
        </div>

        <div id="chat-popup-window" class="sairh-chat-window" aria-hidden="true" dir="ltr">
            <div class="sairh-chat-header">
                <div class="sairh-chat-header-info">
                    <div class="sairh-chat-avatar">
                        <i class="bi bi-robot"></i>
                        <span class="sairh-chat-status-dot" title="Online"></span>
                    </div>
                    <div class="sairh-chat-header-text">
                        <h4 id="chat-title" class="sairh-chat-title">SAIRH AI Assistant</h4>
                        <span id="chat-status" class="sairh-chat-status">Online &bull; 2026 Summit Guide</span>
                    </div>
                </div>
                <div class="sairh-chat-header-actions">
                    <button type="button" id="lang-toggle" class="sairh-chat-lang-btn" onclick="toggleLanguage()" aria-label="Switch Language">
                        <i class="bi bi-globe"></i>
                        <span id="lang-toggle-text">العربية</span>
                    </button>
                    <button type="button" class="sairh-chat-close-btn" onclick="toggleChatWindow()" aria-label="Close Chat">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>

            <div class="sairh-chat-banner">
                <i class="bi bi-info-circle-fill"></i>
                <span id="chat-banner-text">Official AI Summit Guide for SAIRH 2026</span>
            </div>

            <div class="sairh-chat-messages" id="chat-messages" role="log" aria-live="polite">
            </div>

            <div class="sairh-chat-footer">
                <div class="sairh-chat-input-bar">
                    <input type="text" id="user-input" class="sairh-chat-input" maxlength="500" placeholder="Ask about sessions, venue, registration..." autocomplete="off" />
                    <button type="button" id="send-btn" class="sairh-chat-send-btn" onclick="submitUserQuery()" aria-label="Send Message">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </div>
                <div class="sairh-chat-watermark">
                    <span>SAIRH 2026 &bull; Year of Artificial Intelligence</span>
                </div>
            </div>
        </div>

        <script src="<%= ResolveUrl("~/Scripts/chat.js?v=20261004") %>"></script>
    </form>
</body>
</html>
