@{
    ViewData["Title"] = "Personalized Summit Survey";
}


<div class="survey-page">


    <!-- ========================================
         PAGE HEADER
    ========================================= -->

    <div class="survey-header">

        <span class="survey-tag">
            PERSONALIZED EXPERIENCE
        </span>

        <h1>
            Build Your Summit Roadmap
        </h1>

        <p>
            Tell us what interests you and we’ll recommend the sponsor booths
            and research displays that best match your SAIRH 2026 experience.
        </p>

    </div>



    <!-- ========================================
         SURVEY FORM
    ========================================= -->

    <form asp-controller="Survey"
          asp-action="GenerateRoadmap"
          method="post"
          id="roadmapSurvey">


        <!-- ========================================
             QUESTION 1
        ========================================= -->

        <div class="survey-card">

            <div class="question-number">
                01
            </div>


            <div class="question-content">

                <div class="question-heading">

                    <h2>
                        What are you most interested in exploring at SAIRH 2026?
                    </h2>

                    <p class="question-help">
                        Select all that apply.
                    </p>

                </div>


                <div class="option-grid">


                    <label class="survey-option">

                        <input type="checkbox"
                               name="interests"
                               value="AI & Digital Technology" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            AI & Digital Technology
                        </span>

                    </label>


                    <label class="survey-option">

                        <input type="checkbox"
                               name="interests"
                               value="Medical Imaging & Radiology" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            Medical Imaging & Radiology
                        </span>

                    </label>


                    <label class="survey-option">

                        <input type="checkbox"
                               name="interests"
                               value="Health Innovation" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            Health Innovation
                        </span>

                    </label>


                    <label class="survey-option">

                        <input type="checkbox"
                               name="interests"
                               value="Research & Education" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            Research & Education
                        </span>

                    </label>


                    <label class="survey-option">

                        <input type="checkbox"
                               name="interests"
                               value="Startups & Innovation" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            Startups & Innovation
                        </span>

                    </label>


                    <label class="survey-option">

                        <input type="checkbox"
                               name="interests"
                               value="Healthcare Technology" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            Healthcare Technology
                        </span>

                    </label>


                </div>

            </div>

        </div>



        <!-- ========================================
             QUESTION 2
        ========================================= -->

        <div class="survey-card">

            <div class="question-number">
                02
            </div>


            <div class="question-content">

                <div class="question-heading">

                    <h2>
                        What type of exhibition areas would you like to explore?
                    </h2>

                    <p class="question-help">
                        Select all that apply.
                    </p>

                </div>


                <div class="option-grid">


                    <label class="survey-option">

                        <input type="checkbox"
                               name="boothTypes"
                               value="Medical Imaging Companies" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            Medical Imaging Companies
                        </span>

                    </label>


                    <label class="survey-option">

                        <input type="checkbox"
                               name="boothTypes"
                               value="AI Companies" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            AI Companies
                        </span>

                    </label>


                    <label class="survey-option">

                        <input type="checkbox"
                               name="boothTypes"
                               value="Universities & Colleges" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            Universities & Colleges
                        </span>

                    </label>


                    <label class="survey-option">

                        <input type="checkbox"
                               name="boothTypes"
                               value="Healthcare Organizations" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            Healthcare Organizations
                        </span>

                    </label>


                    <label class="survey-option">

                        <input type="checkbox"
                               name="boothTypes"
                               value="Startups" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            Startups
                        </span>

                    </label>


                    <label class="survey-option">

                        <input type="checkbox"
                               name="boothTypes"
                               value="Research Displays" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            Research Project Displays
                        </span>

                    </label>


                </div>

            </div>

        </div>



        <!-- ========================================
             QUESTION 3
        ========================================= -->

        <div class="survey-card">

            <div class="question-number">
                03
            </div>


            <div class="question-content">

                <div class="question-heading">

                    <h2>
                        What would you like to get out of your visit?
                    </h2>

                    <p class="question-help">
                        Select all that apply.
                    </p>

                </div>


                <div class="option-grid">


                    <label class="survey-option">

                        <input type="checkbox"
                               name="goals"
                               value="New Technology" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            Discover new technologies
                        </span>

                    </label>


                    <label class="survey-option">

                        <input type="checkbox"
                               name="goals"
                               value="Research" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            Explore research projects
                        </span>

                    </label>


                    <label class="survey-option">

                        <input type="checkbox"
                               name="goals"
                               value="Products" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            Explore products and services
                        </span>

                    </label>


                    <label class="survey-option">

                        <input type="checkbox"
                               name="goals"
                               value="Healthcare Solutions" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            Find healthcare solutions
                        </span>

                    </label>


                    <label class="survey-option">

                        <input type="checkbox"
                               name="goals"
                               value="Innovation" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            Discover startups and innovations
                        </span>

                    </label>


                    <label class="survey-option">

                        <input type="checkbox"
                               name="goals"
                               value="Networking" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            Network with organizations and professionals
                        </span>

                    </label>


                </div>

            </div>

        </div>



        <!-- ========================================
             QUESTION 4
        ========================================= -->

        <div class="survey-card">

            <div class="question-number">
                04
            </div>


            <div class="question-content">

                <div class="question-heading">

                    <h2>
                        How many recommended stops would you like?
                    </h2>

                    <p class="question-help">
                        Choose the experience that best fits your available time.
                    </p>

                </div>


                <div class="visit-options">


                    <!-- QUICK VISIT -->

                    <label class="visit-card">

                        <input type="radio"
                               name="boothCount"
                               value="3" />

                        <div class="visit-card-top">

                            <span class="visit-number">
                                3
                            </span>

                            <span class="radio-indicator"></span>

                        </div>


                        <span class="visit-title">
                            Quick Visit
                        </span>

                        <span class="visit-count">
                            3 recommended stops
                        </span>

                    </label>



                    <!-- RECOMMENDED -->

                    <label class="visit-card">

                        <input type="radio"
                               name="boothCount"
                               value="5"
                               checked />

                        <div class="visit-card-top">

                            <span class="visit-number">
                                5
                            </span>

                            <span class="radio-indicator"></span>

                        </div>


                        <span class="visit-title">
                            Recommended Experience
                        </span>

                        <span class="visit-count">
                            5 recommended stops
                        </span>

                        <span class="recommended-label">
                            RECOMMENDED
                        </span>

                    </label>



                    <!-- EXPLORE MORE -->

                    <label class="visit-card">

                        <input type="radio"
                               name="boothCount"
                               value="8" />

                        <div class="visit-card-top">

                            <span class="visit-number">
                                8
                            </span>

                            <span class="radio-indicator"></span>

                        </div>


                        <span class="visit-title">
                            Explore More
                        </span>

                        <span class="visit-count">
                            8 recommended stops
                        </span>

                    </label>


                </div>

            </div>

        </div>



        <!-- ========================================
             SUBMIT
        ========================================= -->

        <div class="survey-submit">

            <div class="survey-submit-note">
                You can update your preferences later.
            </div>


            <button type="submit">

                Generate My Roadmap

                <span class="submit-arrow">
                    →
                </span>

            </button>

        </div>


    </form>

</div>



<style>

    /* ========================================
       PAGE
    ======================================== */

    body {
        background-color: #F8FAFC;
        color: #051C3E;
    }


    .survey-page {
        width: 100%;
        max-width: 1180px;

        margin: 0 auto;

        padding:
            50px 28px 75px;
    }



    /* ========================================
       HEADER
    ======================================== */

    .survey-header {
        margin-bottom: 34px;
    }


    .survey-tag {
        display: inline-block;

        color: #0079FF;

        font-size: 12px;
        font-weight: 700;

        letter-spacing: 1.4px;

        margin-bottom: 11px;
    }


    .survey-header h1 {
        color: #051C3E;

        font-size: 42px;
        font-weight: 700;

        line-height: 1.15;

        margin:
            0 0 12px;
    }


    .survey-header p {
        max-width: 820px;

        color: #5F6670;

        font-size: 17px;
        line-height: 1.6;

        margin: 0;
    }



    /* ========================================
       QUESTION CARDS
    ======================================== */

    .survey-card {
        display: grid;

        grid-template-columns:
            50px 1fr;

        gap: 22px;

        position: relative;

        margin-bottom: 18px;

        padding: 25px 28px;

        background-color: #FFFFFF;

        border: 1px solid #E2E8F0;
        border-radius: 14px;

        box-shadow:
            0 3px 12px rgba(5, 28, 62, 0.025);
    }


    .question-number {
        width: 42px;
        height: 42px;

        display: flex;

        align-items: center;
        justify-content: center;

        background-color: #EAF4FF;

        border-radius: 10px;

        color: #0079FF;

        font-size: 14px;
        font-weight: 800;

        letter-spacing: 0.5px;
    }


    .question-content {
        min-width: 0;
    }


    .question-heading {
        margin-bottom: 18px;
    }


    .question-content h2 {
        color: #051C3E;

        font-size: 21px;
        font-weight: 650;

        line-height: 1.35;

        margin:
            0 0 5px;
    }


    .question-help {
        color: #7B8490;

        font-size: 14px;

        margin: 0;
    }



    /* ========================================
       CHECKBOX OPTIONS
    ======================================== */

    .option-grid {
        display: grid;

        grid-template-columns:
            repeat(2, minmax(0, 1fr));

        gap: 10px;
    }


    .survey-option {
        position: relative;

        display: flex;

        align-items: center;

        min-height: 54px;

        gap: 12px;

        padding: 12px 14px;

        background-color: #FFFFFF;

        border: 1px solid #D9E2EC;
        border-radius: 9px;

        cursor: pointer;

        transition:
            border-color 0.18s ease,
            background-color 0.18s ease,
            box-shadow 0.18s ease;
    }


    .survey-option:hover {
        border-color: #82BBFF;

        background-color: #F7FBFF;
    }


    .survey-option input {
        position: absolute;

        opacity: 0;

        pointer-events: none;
    }


    .custom-check {
        width: 20px;
        height: 20px;

        flex-shrink: 0;

        display: flex;

        align-items: center;
        justify-content: center;

        background-color: #FFFFFF;

        border: 1.5px solid #B8C4D0;
        border-radius: 5px;

        transition: 0.18s ease;
    }


    .custom-check::after {
        content: "✓";

        display: none;

        color: #FFFFFF;

        font-size: 13px;
        font-weight: 800;
    }


    .option-text {
        color: #051C3E;

        font-size: 14px;
        font-weight: 500;

        line-height: 1.35;
    }


    /*
       SELECTED CHECKBOX
    */

    .survey-option:has(input:checked) {
        background-color: #EEF6FF;

        border-color: #0079FF;

        box-shadow:
            0 0 0 2px
            rgba(0, 121, 255, 0.08);
    }


    .survey-option:has(input:checked)
    .custom-check {
        background-color: #0079FF;

        border-color: #0079FF;
    }


    .survey-option:has(input:checked)
    .custom-check::after {
        display: block;
    }


    .survey-option:has(input:checked)
    .option-text {
        color: #005EC7;

        font-weight: 650;
    }



    /* ========================================
       VISIT LENGTH OPTIONS
    ======================================== */

    .visit-options {
        display: grid;

        grid-template-columns:
            repeat(3, minmax(0, 1fr));

        gap: 12px;
    }


    .visit-card {
        position: relative;

        display: flex;

        flex-direction: column;

        min-height: 145px;

        padding: 17px;

        background-color: #FFFFFF;

        border: 1px solid #D9E2EC;
        border-radius: 11px;

        cursor: pointer;

        transition:
            border-color 0.18s ease,
            background-color 0.18s ease,
            transform 0.18s ease,
            box-shadow 0.18s ease;
    }


    .visit-card:hover {
        border-color: #82BBFF;

        transform: translateY(-1px);

        box-shadow:
            0 5px 14px
            rgba(5, 28, 62, 0.05);
    }


    .visit-card input {
        position: absolute;

        opacity: 0;

        pointer-events: none;
    }


    .visit-card-top {
        display: flex;

        justify-content: space-between;

        align-items: center;

        margin-bottom: 13px;
    }


    .visit-number {
        color: #0079FF;

        font-size: 26px;
        font-weight: 750;

        line-height: 1;
    }


    .radio-indicator {
        width: 19px;
        height: 19px;

        border: 1.5px solid #B8C4D0;
        border-radius: 50%;

        background-color: #FFFFFF;

        position: relative;
    }


    .radio-indicator::after {
        content: "";

        position: absolute;

        width: 9px;
        height: 9px;

        top: 50%;
        left: 50%;

        transform:
            translate(-50%, -50%);

        background-color: #FFFFFF;

        border-radius: 50%;

        opacity: 0;
    }


    .visit-title {
        color: #051C3E;

        font-size: 15px;
        font-weight: 650;

        margin-bottom: 4px;
    }


    .visit-count {
        color: #7B8490;

        font-size: 13px;
    }


    .recommended-label {
        position: absolute;

        right: 14px;
        bottom: 12px;

        color: #0079FF;

        font-size: 9px;
        font-weight: 800;

        letter-spacing: 0.7px;
    }



    /* ========================================
       SELECTED VISIT CARD
    ======================================== */

    .visit-card:has(input:checked) {
        background-color: #F0F7FF;

        border: 2px solid #0079FF;

        box-shadow:
            0 0 0 2px
            rgba(0, 121, 255, 0.07);
    }


    .visit-card:has(input:checked)
    .visit-number {
        color: #005EC7;
    }


    .visit-card:has(input:checked)
    .radio-indicator {
        background-color: #0079FF;

        border-color: #0079FF;
    }


    .visit-card:has(input:checked)
    .radio-indicator::after {
        opacity: 1;
    }



    /* ========================================
       SUBMIT
    ======================================== */

    .survey-submit {
        display: flex;

        justify-content: space-between;
        align-items: center;

        gap: 20px;

        margin-top: 26px;

        padding-top: 5px;
    }


    .survey-submit-note {
        color: #8A95A2;

        font-size: 13px;
    }


    .survey-submit button {
        min-width: 230px;

        display: flex;

        align-items: center;
        justify-content: center;

        gap: 13px;

        padding: 14px 22px;

        background-color: #0079FF;

        color: #FFFFFF;

        border: none;
        border-radius: 9px;

        font-size: 15px;
        font-weight: 650;

        cursor: pointer;

        box-shadow:
            0 5px 14px
            rgba(0, 121, 255, 0.16);

        transition:
            background-color 0.18s ease,
            transform 0.18s ease;
    }


    .survey-submit button:hover {
        background-color: #0065D8;

        transform: translateY(-1px);
    }


    .submit-arrow {
        font-size: 18px;

        line-height: 1;
    }



    /* ========================================
       RESPONSIVE
    ======================================== */

    @@media (max-width: 800px) {

        .survey-page {
            padding:
                32px 16px 55px;
        }


        .survey-header h1 {
            font-size: 34px;
        }


        .survey-card {
            grid-template-columns: 1fr;

            gap: 14px;

            padding: 21px;
        }


        .question-number {
            width: 38px;
            height: 38px;
        }


        .option-grid {
            grid-template-columns: 1fr;
        }


        .visit-options {
            grid-template-columns: 1fr;
        }


        .visit-card {
            min-height: 120px;
        }


        .survey-submit {
            flex-direction: column;

            align-items: stretch;
        }


        .survey-submit-note {
            text-align: center;
        }


        .survey-submit button {
            width: 100%;
        }

    }


</style>