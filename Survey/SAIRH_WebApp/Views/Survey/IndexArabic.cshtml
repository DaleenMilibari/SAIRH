@{
    ViewData["Title"] = "المسار الشخصي للقمة";
}

<div class="survey-page" dir="rtl">

    <div class="survey-header">

        <span class="survey-tag">
            تجربة مخصصة
        </span>

        <h1>
            أنشئ مسارك الخاص في القمة
        </h1>

        <p>
            أخبرنا باهتماماتك وسنقترح عليك أجنحة الرعاة والعروض البحثية
            التي تتناسب بشكل أفضل مع تجربتك في SAIRH 2026.
        </p>

    </div>


    <form asp-controller="Survey"
      asp-action="GenerateRoadmap"
      method="post"
      id="roadmapSurvey">

    <input type="hidden"
           name="language"
           value="ar" />

        <!-- السؤال الأول -->

        <div class="survey-card">

            <div class="question-number">
                01
            </div>

            <div class="question-content">

                <div class="question-heading">

                    <h2>
                        ما المجالات التي تهتم باستكشافها أكثر في SAIRH 2026؟
                    </h2>

                    <p class="question-help">
                        يمكنك اختيار أكثر من خيار.
                    </p>

                </div>


                <div class="option-grid">

                    <label class="survey-option">

                        <input type="checkbox"
                               name="interests"
                               value="AI & Digital Technology" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            الذكاء الاصطناعي والتقنية الرقمية
                        </span>

                    </label>


                    <label class="survey-option">

                        <input type="checkbox"
                               name="interests"
                               value="Medical Imaging & Radiology" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            التصوير الطبي والأشعة
                        </span>

                    </label>


                    <label class="survey-option">

                        <input type="checkbox"
                               name="interests"
                               value="Health Innovation" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            الابتكار الصحي
                        </span>

                    </label>


                    <label class="survey-option">

                        <input type="checkbox"
                               name="interests"
                               value="Research & Education" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            البحث والتعليم
                        </span>

                    </label>


                    <label class="survey-option">

                        <input type="checkbox"
                               name="interests"
                               value="Startups & Innovation" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            الشركات الناشئة والابتكار
                        </span>

                    </label>


                    <label class="survey-option">

                        <input type="checkbox"
                               name="interests"
                               value="Healthcare Technology" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            تقنيات الرعاية الصحية
                        </span>

                    </label>

                </div>

            </div>

        </div>



        <!-- السؤال الثاني -->

        <div class="survey-card">

            <div class="question-number">
                02
            </div>

            <div class="question-content">

                <div class="question-heading">

                    <h2>
                        ما أنواع مناطق المعرض التي ترغب في استكشافها؟
                    </h2>

                    <p class="question-help">
                        يمكنك اختيار أكثر من خيار.
                    </p>

                </div>


                <div class="option-grid">

                    <label class="survey-option">

                        <input type="checkbox"
                               name="boothTypes"
                               value="Medical Imaging Companies" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            شركات التصوير الطبي
                        </span>

                    </label>


                    <label class="survey-option">

                        <input type="checkbox"
                               name="boothTypes"
                               value="AI Companies" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            شركات الذكاء الاصطناعي
                        </span>

                    </label>


                    <label class="survey-option">

                        <input type="checkbox"
                               name="boothTypes"
                               value="Universities & Colleges" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            الجامعات والكليات
                        </span>

                    </label>


                    <label class="survey-option">

                        <input type="checkbox"
                               name="boothTypes"
                               value="Healthcare Organizations" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            الجهات الصحية
                        </span>

                    </label>


                    <label class="survey-option">

                        <input type="checkbox"
                               name="boothTypes"
                               value="Startups" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            الشركات الناشئة
                        </span>

                    </label>


                    <label class="survey-option">

                        <input type="checkbox"
                               name="boothTypes"
                               value="Research Displays" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            عروض المشاريع البحثية
                        </span>

                    </label>

                </div>

            </div>

        </div>



        <!-- السؤال الثالث -->

        <div class="survey-card">

            <div class="question-number">
                03
            </div>

            <div class="question-content">

                <div class="question-heading">

                    <h2>
                        ما الذي ترغب في تحقيقه من زيارتك؟
                    </h2>

                    <p class="question-help">
                        يمكنك اختيار أكثر من خيار.
                    </p>

                </div>


                <div class="option-grid">

                    <label class="survey-option">

                        <input type="checkbox"
                               name="goals"
                               value="New Technology" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            اكتشاف تقنيات جديدة
                        </span>

                    </label>


                    <label class="survey-option">

                        <input type="checkbox"
                               name="goals"
                               value="Research" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            استكشاف المشاريع البحثية
                        </span>

                    </label>


                    <label class="survey-option">

                        <input type="checkbox"
                               name="goals"
                               value="Products" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            استكشاف المنتجات والخدمات
                        </span>

                    </label>


                    <label class="survey-option">

                        <input type="checkbox"
                               name="goals"
                               value="Healthcare Solutions" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            التعرف على حلول الرعاية الصحية
                        </span>

                    </label>


                    <label class="survey-option">

                        <input type="checkbox"
                               name="goals"
                               value="Innovation" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            اكتشاف الشركات الناشئة والابتكارات
                        </span>

                    </label>


                    <label class="survey-option">

                        <input type="checkbox"
                               name="goals"
                               value="Networking" />

                        <span class="custom-check"></span>

                        <span class="option-text">
                            التواصل مع الجهات والمتخصصين
                        </span>

                    </label>

                </div>

            </div>

        </div>



        <!-- السؤال الرابع -->

        <div class="survey-card">

            <div class="question-number">
                04
            </div>

            <div class="question-content">

                <div class="question-heading">

                    <h2>
                        كم عدد المحطات المقترحة التي ترغب بها؟
                    </h2>

                    <p class="question-help">
                        اختر التجربة التي تناسب الوقت المتاح لديك.
                    </p>

                </div>


                <div class="visit-options">


                    <label class="visit-card">

                        <input type="radio"
                               name="boothCount"
                               value="3" />

                        <div class="visit-card-top">

                            <span class="visit-number">
                                3
                            </span>

                            <span class="radio-indicator"></span>

                        </div>

                        <span class="visit-title">
                            زيارة سريعة
                        </span>

                        <span class="visit-count">
                            3 محطات مقترحة
                        </span>

                    </label>



                    <label class="visit-card">

                        <input type="radio"
                               name="boothCount"
                               value="5"
                               checked />

                        <div class="visit-card-top">

                            <span class="visit-number">
                                5
                            </span>

                            <span class="radio-indicator"></span>

                        </div>

                        <span class="visit-title">
                            التجربة الموصى بها
                        </span>

                        <span class="visit-count">
                            5 محطات مقترحة
                        </span>

                        <span class="recommended-label">
                            موصى بها
                        </span>

                    </label>



                    <label class="visit-card">

                        <input type="radio"
                               name="boothCount"
                               value="8" />

                        <div class="visit-card-top">

                            <span class="visit-number">
                                8
                            </span>

                            <span class="radio-indicator"></span>

                        </div>

                        <span class="visit-title">
                            استكشف أكثر
                        </span>

                        <span class="visit-count">
                            8 محطات مقترحة
                        </span>

                    </label>

                </div>

            </div>

        </div>



        <div class="survey-submit">

            <div class="survey-submit-note">
                يمكنك تعديل تفضيلاتك لاحقًا.
            </div>

            <button type="submit">

                أنشئ مساري

                <span class="submit-arrow">
                    ←
                </span>

            </button>

        </div>

    </form>

</div>


<style>

    body {
        background-color: #F8FAFC;
        color: #051C3E;
    }

    .survey-page {
        width: 100%;
        max-width: 1180px;
        margin: 0 auto;
        padding: 50px 28px 75px;

        direction: rtl;
        text-align: right;

        font-family:
            "Segoe UI",
            Tahoma,
            Arial,
            sans-serif;
    }


    /* HEADER */

    .survey-header {
        margin-bottom: 34px;
    }

    .survey-tag {
        display: inline-block;
        color: #0079FF;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0;
        margin-bottom: 11px;
    }

    .survey-header h1 {
        color: #051C3E;
        font-size: 42px;
        font-weight: 700;
        line-height: 1.35;
        margin: 0 0 12px;
    }

    .survey-header p {
        max-width: 820px;
        color: #5F6670;
        font-size: 17px;
        line-height: 1.8;
        margin: 0;
    }


    /* QUESTION CARDS */

    .survey-card {
        display: grid;
        grid-template-columns: 50px 1fr;
        gap: 22px;

        position: relative;

        margin-bottom: 18px;
        padding: 25px 28px;

        background-color: #FFFFFF;

        border: 1px solid #E2E8F0;
        border-radius: 14px;

        box-shadow:
            0 3px 12px rgba(5, 28, 62, 0.025);
    }

    .question-number {
        width: 42px;
        height: 42px;

        display: flex;
        align-items: center;
        justify-content: center;

        background-color: #EAF4FF;

        border-radius: 10px;

        color: #0079FF;

        font-size: 14px;
        font-weight: 800;
    }

    .question-content {
        min-width: 0;
    }

    .question-heading {
        margin-bottom: 18px;
    }

    .question-content h2 {
        color: #051C3E;

        font-size: 21px;
        font-weight: 650;

        line-height: 1.6;

        margin: 0 0 5px;
    }

    .question-help {
        color: #7B8490;

        font-size: 14px;

        margin: 0;
    }


    /* CHECKBOX OPTIONS */

    .option-grid {
        display: grid;

        grid-template-columns:
            repeat(2, minmax(0, 1fr));

        gap: 10px;
    }

    .survey-option {
        position: relative;

        display: flex;
        align-items: center;

        min-height: 54px;

        gap: 12px;

        padding: 12px 14px;

        background-color: #FFFFFF;

        border: 1px solid #D9E2EC;
        border-radius: 9px;

        cursor: pointer;

        transition:
            border-color 0.18s ease,
            background-color 0.18s ease,
            box-shadow 0.18s ease;
    }

    .survey-option:hover {
        border-color: #82BBFF;
        background-color: #F7FBFF;
    }

    .survey-option input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .custom-check {
        width: 20px;
        height: 20px;

        flex-shrink: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        background-color: #FFFFFF;

        border: 1.5px solid #B8C4D0;
        border-radius: 5px;

        transition: 0.18s ease;
    }

    .custom-check::after {
        content: "✓";

        display: none;

        color: #FFFFFF;

        font-size: 13px;
        font-weight: 800;
    }

    .option-text {
        color: #051C3E;

        font-size: 14px;
        font-weight: 500;

        line-height: 1.6;
    }

    .survey-option:has(input:checked) {
        background-color: #EEF6FF;

        border-color: #0079FF;

        box-shadow:
            0 0 0 2px rgba(0, 121, 255, 0.08);
    }

    .survey-option:has(input:checked) .custom-check {
        background-color: #0079FF;
        border-color: #0079FF;
    }

    .survey-option:has(input:checked) .custom-check::after {
        display: block;
    }

    .survey-option:has(input:checked) .option-text {
        color: #005EC7;
        font-weight: 650;
    }


    /* VISIT OPTIONS */

    .visit-options {
        display: grid;

        grid-template-columns:
            repeat(3, minmax(0, 1fr));

        gap: 12px;
    }

    .visit-card {
        position: relative;

        display: flex;
        flex-direction: column;

        min-height: 145px;

        padding: 17px;

        background-color: #FFFFFF;

        border: 1px solid #D9E2EC;
        border-radius: 11px;

        cursor: pointer;

        transition:
            border-color 0.18s ease,
            background-color 0.18s ease,
            transform 0.18s ease,
            box-shadow 0.18s ease;
    }

    .visit-card:hover {
        border-color: #82BBFF;

        transform: translateY(-1px);

        box-shadow:
            0 5px 14px rgba(5, 28, 62, 0.05);
    }

    .visit-card input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .visit-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;

        margin-bottom: 13px;
    }

    .visit-number {
        color: #0079FF;

        font-size: 26px;
        font-weight: 750;

        line-height: 1;
    }

    .radio-indicator {
        width: 19px;
        height: 19px;

        border: 1.5px solid #B8C4D0;
        border-radius: 50%;

        background-color: #FFFFFF;

        position: relative;
    }

    .radio-indicator::after {
        content: "";

        position: absolute;

        width: 9px;
        height: 9px;

        top: 50%;
        left: 50%;

        transform: translate(-50%, -50%);

        background-color: #FFFFFF;

        border-radius: 50%;

        opacity: 0;
    }

    .visit-title {
        color: #051C3E;

        font-size: 15px;
        font-weight: 650;

        margin-bottom: 4px;
    }

    .visit-count {
        color: #7B8490;

        font-size: 13px;
    }

    .recommended-label {
        position: absolute;

        left: 14px;
        bottom: 12px;

        color: #0079FF;

        font-size: 9px;
        font-weight: 800;
    }

    .visit-card:has(input:checked) {
        background-color: #F0F7FF;

        border: 2px solid #0079FF;

        box-shadow:
            0 0 0 2px rgba(0, 121, 255, 0.07);
    }

    .visit-card:has(input:checked) .visit-number {
        color: #005EC7;
    }

    .visit-card:has(input:checked) .radio-indicator {
        background-color: #0079FF;
        border-color: #0079FF;
    }

    .visit-card:has(input:checked) .radio-indicator::after {
        opacity: 1;
    }


    /* SUBMIT */

    .survey-submit {
        display: flex;

        justify-content: space-between;
        align-items: center;

        gap: 20px;

        margin-top: 26px;

        padding-top: 5px;
    }

    .survey-submit-note {
        color: #8A95A2;

        font-size: 13px;
    }

    .survey-submit button {
        min-width: 230px;

        display: flex;
        align-items: center;
        justify-content: center;

        gap: 13px;

        padding: 14px 22px;

        background-color: #0079FF;

        color: #FFFFFF;

        border: none;
        border-radius: 9px;

        font-size: 15px;
        font-weight: 650;

        cursor: pointer;

        box-shadow:
            0 5px 14px rgba(0, 121, 255, 0.16);

        transition:
            background-color 0.18s ease,
            transform 0.18s ease;
    }

    .survey-submit button:hover {
        background-color: #0065D8;

        transform: translateY(-1px);
    }

    .submit-arrow {
        font-size: 18px;
        line-height: 1;
    }


    /* RESPONSIVE */

    @@media (max-width: 800px) {

        .survey-page {
            padding: 32px 16px 55px;
        }

        .survey-header h1 {
            font-size: 34px;
        }

        .survey-card {
            grid-template-columns: 1fr;

            gap: 14px;

            padding: 21px;
        }

        .question-number {
            width: 38px;
            height: 38px;
        }

        .option-grid {
            grid-template-columns: 1fr;
        }

        .visit-options {
            grid-template-columns: 1fr;
        }

        .visit-card {
            min-height: 120px;
        }

        .survey-submit {
            flex-direction: column;
            align-items: stretch;
        }

        .survey-submit-note {
            text-align: center;
        }

        .survey-submit button {
            width: 100%;
        }
    }

</style>