<!-- ==================================================
     PDF LIBRARIES
=================================================== -->

<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/jspdf@3.0.3/dist/jspdf.umd.min.js"></script>


<script>

    async function downloadRoadmap() {

        const downloadArea =
            document.getElementById("roadmapDownloadArea");

        const downloadButton =
            document.getElementById("downloadRoadmapButton");

        const buttonText =
            document.getElementById("downloadButtonText");


        if (!downloadArea ||
            !downloadButton ||
            typeof html2canvas === "undefined" ||
            !window.jspdf) {

            alert(
                "تعذر تحميل المسار. يرجى تحديث الصفحة والمحاولة مرة أخرى."
            );

            return;
        }


        try {

            /* ==========================================
               PREPARE PAGE
            ========================================== */

            downloadButton.disabled = true;

            buttonText.textContent =
                "جارٍ تجهيز الملف...";

            downloadArea.classList.add(
                "pdf-capture-mode"
            );


            await new Promise(resolve =>
                setTimeout(resolve, 150)
            );


            /* ==========================================
               CAPTURE ROADMAP
            ========================================== */

            const canvas =
                await html2canvas(
                    downloadArea,
                    {
                        scale: 2,

                        backgroundColor:
                            "#FFFFFF",

                        useCORS: true,

                        logging: false,

                        scrollX: 0,

                        scrollY:
                            -window.scrollY,

                        windowWidth:
                            downloadArea.scrollWidth,

                        windowHeight:
                            downloadArea.scrollHeight
                    }
                );


            /* ==========================================
               CREATE PDF
            ========================================== */

            const { jsPDF } =
                window.jspdf;


            const pdf =
                new jsPDF({
                    orientation: "landscape",
                    unit: "mm",
                    format: "a4",
                    compress: true
                });


            const pageWidth =
                pdf.internal.pageSize.getWidth();

            const pageHeight =
                pdf.internal.pageSize.getHeight();


            const margin =
                8;


            const usableWidth =
                pageWidth - (margin * 2);

            const usableHeight =
                pageHeight - (margin * 2);


            const scaleFactor =
                usableWidth / canvas.width;


            const pageHeightPixels =
                usableHeight / scaleFactor;


            let sourceY =
                0;

            let pageNumber =
                0;


            while (sourceY < canvas.height) {

                const remainingHeight =
                    canvas.height - sourceY;


                const sliceHeight =
                    Math.min(
                        pageHeightPixels,
                        remainingHeight
                    );


                const pageCanvas =
                    document.createElement("canvas");


                pageCanvas.width =
                    canvas.width;


                pageCanvas.height =
                    Math.ceil(sliceHeight);


                const pageContext =
                    pageCanvas.getContext("2d");


                pageContext.fillStyle =
                    "#FFFFFF";


                pageContext.fillRect(
                    0,
                    0,
                    pageCanvas.width,
                    pageCanvas.height
                );


                pageContext.drawImage(
                    canvas,

                    0,
                    sourceY,

                    canvas.width,
                    sliceHeight,

                    0,
                    0,

                    canvas.width,
                    sliceHeight
                );


                const pageImage =
                    pageCanvas.toDataURL(
                        "image/png",
                        1.0
                    );


                const renderedHeight =
                    sliceHeight * scaleFactor;


                if (pageNumber > 0) {
                    pdf.addPage();
                }


                pdf.addImage(
                    pageImage,
                    "PNG",

                    margin,
                    margin,

                    usableWidth,
                    renderedHeight,

                    undefined,
                    "FAST"
                );


                sourceY +=
                    sliceHeight;


                pageNumber++;
            }


            /* ==========================================
               DOWNLOAD
            ========================================== */

            pdf.save(
                "SAIRH-2026-Arabic-Roadmap.pdf"
            );

        }
        catch (error) {

            console.error(
                "Roadmap PDF error:",
                error
            );


            alert(
                "تعذر تحميل المسار. يرجى المحاولة مرة أخرى."
            );

        }
        finally {

            downloadArea.classList.remove(
                "pdf-capture-mode"
            );


            downloadButton.disabled =
                false;


            buttonText.textContent =
                "تحميل المسار";

        }

    }

</script>